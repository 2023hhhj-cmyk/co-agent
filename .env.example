# Muzhu-AI 多Agent协同系统 - 环境配置
# 复制此文件为 .env 并填入真实配置

## 服务器信息
SERVER_IP=your-server-ip
SSH_HOST=your-ssh-host
PROJECT_DIR=/root/muzhu-ai

## 数据库配置
# PostgreSQL
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
POSTGRES_USER=muzhu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muzhu_agent
DATABASE_URL=postgresql://muzhu:change-me@localhost:5432/muzhu_agent

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

## 监控服务
# Prometheus
PROMETHEUS_URL=http://your-server-ip:9090

# Grafana
GRAFANA_URL=http://your-server-ip:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

## 工作区并发与模型配额（单进程共享，修改后重启）
WORKSPACE_MAX_CONCURRENT_TASKS=5
LLM_RPM_LIMIT=60
LLM_TPM_LIMIT=60000
# 最多重试 3 次（总共最多 4 次请求），基础等待 1、2、4 秒并加随机抖动。
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1
LLM_RETRY_MAX_DELAY=30

## LLM 配置
# DeepSeek
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

## 文本嵌入（阿里云百炼）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

## 飞书配置
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Jaeger (链路追踪)
JAEGER_URL=http://your-server-ip:16686
JAEGER_AGENT_HOST=your-server-ip
JAEGER_AGENT_PORT=6831

## opencode Docker 执行（必需 Docker daemon 与预先构建的镜像）
# 构建镜像：docker build -t muzhu-sandbox:latest -f security/Dockerfile.opencode security/
OC_SANDBOX_IMAGE=muzhu-sandbox:latest
OC_SANDBOX_MEMORY=1g
OC_SANDBOX_CPUS=1
OC_TASK_TIMEOUT=1500
PUBLIC_BASE_URL=https://www.loveboos-ai.com
# opencode-go provider 的 API key。留空时回退读取宿主机 ~/.local/share/opencode/auth.json。
# 只转发 OPENCODE_API_KEY，不转发数据库、飞书、SSH 等凭证。
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_AGENT=build
